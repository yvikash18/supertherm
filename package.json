{
  "name": "supertherm-corporations",
  "type": "module",
  "version": "1.0.0",
  "description": "Supertherm Corporations — induction heating equipment manufacturer. Modern Astro revamp.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler pages deploy dist --project-name=superthermcorporations",
    "cms:seed": "node scripts/cms-seed.mjs",
    "cms:admin": "node scripts/cms-admin.mjs",
    "cms:dev": "astro build && wrangler pages dev --port 8788"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^4.16.18",
    "gsap": "^3.12.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
