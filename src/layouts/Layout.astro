---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
}

const {
  title = `${company.name} — ${company.tagline}`,
  description = company.intro,
  keywords = 'induction heating equipment, induction forging machine, induction hardening machine, induction melting furnace, high frequency welder, induction billet heater, foundry equipment India',
  image = '/assets/banner-1.jpg',
} = Astro.props;

const siteOrigin = 'https://www.superthermcorporations.com';
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteOrigin);
const ogImage = new URL(image, siteOrigin).toString();

// Site-wide structured data: manufacturer / local business
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: company.name,
  url: siteOrigin,
  logo: `${siteOrigin}/assets/logo.png`,
  description: company.intro,
  foundingDate: String(company.established),
  telephone: company.phoneRaw,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.line1,
    addressLocality: 'Bahadurgarh',
    addressRegion: 'Haryana',
    postalCode: '124507',
    addressCountry: 'IN',
  },
  areaServed: ['India', 'Oman', 'Saudi Arabia', 'Iran', 'Nepal', 'Bhutan', 'Bangladesh', 'Malaysia', 'Vietnam'],
  knowsAbout: ['Induction forging', 'Induction hardening', 'Induction melting', 'High frequency welding'],
  sameAs: [company.social.linkedin, company.social.youtube, company.social.facebook, company.social.twitter],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={company.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical.toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a0a0b" />

    <!-- Organization structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Apply theme + js class ASAP so there's no flash of the wrong theme -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          if (t === 'light') document.documentElement.classList.add('light');
        } catch (e) {}
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="fixed left-4 top-[-100px] z-[100] rounded-lg bg-molten-500 px-4 py-2.5 text-white transition-[top] duration-200 focus:top-4"
      >Skip to content</a
    >

    <!-- Scroll progress bar -->
    <div
      data-progress
      class="fixed inset-x-0 top-0 z-[60] h-[3px] origin-left scale-x-0 bg-gradient-to-r from-molten-400 to-ember"
    >
    </div>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- WhatsApp direct message -->
    <a
      href={`https://wa.me/${company.phoneRaw.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hi Supertherm Corporations, I would like to enquire about your induction heating equipment.')}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with us on WhatsApp"
      class="group fixed bottom-6 left-6 z-40 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_10px_30px_-6px_rgba(37,211,102,0.6)] transition-transform duration-300 hover:scale-105"
    >
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#25D366] opacity-20"></span>
      <svg viewBox="0 0 24 24" fill="currentColor" class="relative h-7 w-7" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.15-.17.2-.34.22-.63.08-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.9-2.19-.24-.57-.48-.5-.66-.5l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.24-.69.24-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.5 9.5 0 01-4.83-1.32l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 01-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.44 9.44 0 012.78 6.72c-.01 5.24-4.27 9.5-9.5 9.5zM20.4 3.6A11.4 11.4 0 0012.05.1C5.8.1.72 5.18.72 11.42c0 2 .52 3.96 1.52 5.68L.62 23l6.05-1.58a11.36 11.36 0 005.38 1.37h.01c6.24 0 11.32-5.08 11.32-11.33 0-3.03-1.18-5.87-3.32-8.01z" />
      </svg>
    </a>

    <!-- Back to top -->
    <button
      data-to-top
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-40 grid h-12 w-12 translate-y-4 place-items-center rounded-full border border-line bg-ink-2/90 text-molten-300 opacity-0 backdrop-blur transition-all duration-300 [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100 hover:border-molten-400 hover:bg-molten-500 hover:text-white"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <!-- Auto-translation (Google Translate, driven by our language dropdown) -->
    <div id="google_translate_element" aria-hidden="true"></div>
    <script is:inline>
      function googleTranslateElementInit() {
        new google.translate.TranslateElement({ pageLanguage: 'en', autoDisplay: false }, 'google_translate_element');
      }
    </script>
    <script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
