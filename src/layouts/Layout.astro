---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { company, socialLinks } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  /** Set when the page opens on a dark hero, so the nav starts clear with light text. */
  darkHero?: boolean;
  /** Alias routes such as /v2 stay out of search results. */
  noindex?: boolean;
}

const {
  title = `${company.name} — ${company.tagline}`,
  description = company.intro,
  keywords = 'induction heating equipment, induction forging machine, induction hardening machine, induction melting furnace, high frequency welder, induction billet heater, foundry equipment India',
  image = '/assets/what-we.jpg',
  darkHero = false,
  noindex = false,
} = Astro.props;

const siteOrigin = 'https://www.superthermcorporations.com';
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteOrigin);
const ogImage = new URL(image, siteOrigin).toString();

// Site-wide structured data: manufacturer / local business
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: company.name,
  url: siteOrigin,
  logo: `${siteOrigin}/assets/logo.png`,
  description: company.intro,
  foundingDate: String(company.established),
  telephone: company.phoneRaw,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.line1,
    addressLocality: 'Bahadurgarh',
    addressRegion: 'Haryana',
    postalCode: '124507',
    addressCountry: 'IN',
  },
  areaServed: ['India', 'Oman', 'Saudi Arabia', 'Iran', 'Nepal', 'Bhutan', 'Bangladesh', 'Malaysia', 'Vietnam'],
  knowsAbout: ['Induction forging', 'Induction hardening', 'Induction melting', 'High frequency welding'],
  sameAs: socialLinks.map((s) => s.url).filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={company.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical.toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content={darkHero ? '#0c141c' : '#e7eae7'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" />

    <!-- Organization structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Motion styles are scoped to html.js, so content is never hidden without scripts -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <Nav overDark={darkHero} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a
      href={`https://wa.me/${company.phoneRaw.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hi Supertherm Corporations, I would like to enquire about your induction heating equipment.')}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Message Supertherm on WhatsApp"
      class="wa"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.15-.17.2-.34.22-.63.08-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.9-2.19-.24-.57-.48-.5-.66-.5l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.24-.69.24-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.5 9.5 0 01-4.83-1.32l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 01-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.44 9.44 0 012.78 6.72c-.01 5.24-4.27 9.5-9.5 9.5zM20.4 3.6A11.4 11.4 0 0012.05.1C5.8.1.72 5.18.72 11.42c0 2 .52 3.96 1.52 5.68L.62 23l6.05-1.58a11.36 11.36 0 005.38 1.37h.01c6.24 0 11.32-5.08 11.32-11.33 0-3.03-1.18-5.87-3.32-8.01z" />
      </svg>
    </a>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .skip { position: fixed; left: 1rem; top: -100px; z-index: 100; background: var(--steel); color: #fff; padding: 0.6rem 1rem; border-radius: 3px; }
  .skip:focus { top: 1rem; }
  .wa {
    position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 40; width: 3.25rem; height: 3.25rem; border-radius: 50%;
    display: grid; place-items: center; background: #1faf54; color: #fff; box-shadow: 0 6px 18px rgba(12, 20, 28, 0.28);
    transition: transform 0.2s, opacity 0.3s;
  }
  /* Stays out of the way of the opening screen, which has its own call button */
  :global(.js:not(.is-past-hero)) .wa { opacity: 0; pointer-events: none; }
  .wa:hover { transform: scale(1.06); }
</style>
