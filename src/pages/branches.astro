---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Display from '../components/Display.astro';
import Enquiry from '../components/Enquiry.astro';
import { branches, countries, companyDetails, serviceCities } from '../data/content';
import { bankDetails } from '../data/content';
import { company, heroFor } from '../data/content';
import { tel } from '../lib/format';

const hero = heroFor('branches');
const head = branches.find((b) => b.primary)!;
const rest = branches.filter((b) => !b.primary);
const mapQuery = encodeURIComponent(`${company.address.line1}, ${company.address.line2}, ${company.address.country}`);
const details = [
  ['GST number', companyDetails.gst],
  ['PAN', companyDetails.pan],
  ['Udyog Aadhar', companyDetails.udyogAadhar],
  ['Company ARN', companyDetails.arn],
  ['HSN, machines', companyDetails.hsnMachines],
  ['HSN, services', companyDetails.hsnServices],
];
---

<Layout title={`Branches & Contact Offices | ${company.name}`} description="Supertherm head office & works in Bahadurgarh (Haryana) plus branch offices in Aurangabad, Ludhiana, Bengaluru, Kanpur, Kolkata and Balasore, serving nine countries across Asia & the Gulf.">
  <PageHero title={hero.title} subtitle={hero.subtitle} />

  <section class="section">
    <div class="wrap ho">
      <div>
        <p class="role">{head.role}</p>
        <Display text={head.city} />
        <address>{head.address}</address>
        <ul class="phones num">
          {head.phones.map((ph) => <li><a href={`tel:${tel(ph)}`}>{ph}</a></li>)}
          <li><a href={`mailto:${head.email}`}>{head.email}</a></li>
          <li><a href={`mailto:${company.accountsEmail}`}>{company.accountsEmail}</a> <span class="tag">accounts</span></li>
        </ul>
        <a class="btn btn-solid" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener">Open in Google Maps</a>
      </div>
      <div class="map" data-wipe>
        <iframe title="Map: Supertherm Corporations head office and works, Bahadurgarh" src={`https://www.google.com/maps?q=${mapQuery}&z=14&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <Display text="Regional offices" />
      <ul class="rows offices">
        {rest.map((b, i) => (
          <li data-in style={`--i:${i}`}>
            <div><h3 class="display display-sm">{b.city}</h3><p class="region">{b.region}</p></div>
            <address>{b.contact && <strong>{b.contact}<br /></strong>}{b.address}</address>
            <div class="reach num">
              {b.phones.map((ph) => <a href={`tel:${tel(ph)}`}>{ph}</a>)}
              <a href={`mailto:${b.email}`}>{b.email}</a>
            </div>
          </li>
        ))}
      </ul>
      <p class="also" data-in><span>Service engineers also cover</span> {serviceCities.join(', ')}.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <Display text="Countries we serve" />
        <p class="lede lead" data-in>Machines installed and supported across South Asia, Southeast Asia and the Gulf.</p>
      </div>
      <ul class="countries">
        {countries.map((c, i) => <li class="display display-sm" data-in style={`--i:${i}`}>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight alt">
    <div class="wrap">
      <h2 class="h3">Company registration</h2>
      <dl class="reg num">
        {details.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <h2 class="h3 bank">Bank details for RTGS / NEFT</h2>
      <dl class="reg num">
        <div><dt>Bank</dt><dd>{bankDetails.bank}</dd></div>
        <div><dt>Branch</dt><dd>{bankDetails.branch}</dd></div>
        <div><dt>IFSC</dt><dd>{bankDetails.ifsc}</dd></div>
        <div><dt>Account number</dt><dd>{bankDetails.account}</dd></div>
      </dl>
    </div>
  </section>

  <Enquiry />
</Layout>

<style>
  .ho { display: grid; gap: 2.5rem; }
  .role { color: var(--fg-3); margin-bottom: 0.75rem; }
  address { font-style: normal; color: var(--fg-2); }
  .ho address { margin-top: 1.5rem; max-width: 26rem; font-size: 1.15rem; }
  .phones { margin-block: 1.5rem 2rem; display: flex; flex-direction: column; gap: 0.35rem; font-weight: 600; }
  a[href^='tel']:hover, a[href^='mailto']:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 0.2em; }
  .map { position: relative; min-height: 22rem; border-radius: 3px; overflow: hidden; background: var(--rule); }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(0.4); }
  .alt { background: var(--plate); border-block: 1px solid var(--line); }
  .offices { margin-top: clamp(2rem, 4vw, 3.5rem); }
  .offices li { display: grid; gap: 0.75rem 2.5rem; padding-block: 1.75rem; }
  .region { color: var(--fg-3); margin-top: 0.35rem; }
  .reach { display: flex; flex-direction: column; gap: 0.25rem; font-weight: 600; overflow-wrap: anywhere; }
  .lead { margin-top: 1.5rem; }
  .also { margin-top: 2rem; font-weight: 550; }
  .also span, .tag { color: var(--fg-3); font-weight: 400; }
  .countries { display: flex; flex-wrap: wrap; gap: 0.4rem clamp(1.25rem, 3vw, 3rem); color: var(--cab); }
  .reg { margin-top: 1.25rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem 2rem; }
  .bank { margin-top: 2.5rem; }
  .reg dt { color: var(--fg-3); font-size: 0.875rem; }
  .reg dd { font-weight: 600; overflow-wrap: anywhere; }
  @media (min-width: 900px) {
    .ho { grid-template-columns: 1fr 1.2fr; gap: 4rem; }
    .offices li { grid-template-columns: 1fr 1.4fr 1fr; align-items: start; }
    .split { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem; align-items: start; }
    .reg { grid-template-columns: repeat(6, 1fr); }
  }
  @media (max-width: 899px) { .countries { margin-top: 2rem; } }
</style>
