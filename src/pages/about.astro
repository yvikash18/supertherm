---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Display from '../components/Display.astro';
import Plate from '../components/Plate.astro';
import Enquiry from '../components/Enquiry.astro';
import { aboutImages, visionMission, productFeatures, comparison, advantages } from '../data/content';
import { company, heroFor } from '../data/content';

const hero = heroFor('about');
const disciplines = ['Electronics', 'Electrical', 'Automation', 'Mechanical', 'Metallurgical'];
const glance = [
  ['Head office and works', 'Bahadurgarh, Haryana'],
  ['Melting power sources', 'Up to 750 kW, IGBT (1 to 1.5 ton)'],
  ['HF welding', 'MOSFET based'],
  ['Forging power sources', '50 to 2000 kW'],
  ['Countries served', '9'],
  ['Service line', 'Open 24 hours'],
];
---

<Layout title={`About | ${company.name}`} description="Three decades engineering induction heating equipment in-house, from R&D to lifetime service.">
  <PageHero title={hero.title} subtitle={hero.subtitle} />

  <section class="section">
    <div class="wrap story">
      <div class="text">
        <p class="big" data-in>Supertherm Corporations is a world-class manufacturer of induction heating equipment: hardening machines, billet and bar heaters, melting power sources up to 750 kW, high-frequency welders, and annealing and brazing sets. More than 550 of our hardening and melting machines, with IGBT inverters and digital control, are in service.</p>
        <p data-in>The company was started by professionals with more than 30 years in induction applications, and the machines are designed by the people who build them. Our R&D group covers five engineering disciplines, so the coil, the power source and the control system are worked out together for the part you are heating.</p>
        <p data-in>We offer a complete induction solution, built by highly professional and qualified staff. Because we build it, we can keep it running. The service line is answered around the clock, spare parts are our own, and operators are trained on the machine before it leaves the works.</p>
        <dl class="rows glance" data-in>
          {glance.map(([k, v]) => <div class="kv"><dt>{k}</dt><dd class="num">{v}</dd></div>)}
        </dl>
      </div>
      <div class="shots">
        <div class="shot a" data-wipe><img class="photo" src={aboutImages.capability2} alt="Billet heater with in-feed conveyor at the Supertherm works" loading="lazy" width="1200" height="900" /></div>
        <div class="shot b" data-wipe><img class="photo" src={aboutImages.primary} alt="Supertherm induction machine and control cabinet" loading="lazy" width="500" height="500" /></div>
      </div>
    </div>
  </section>

  <Plate />

  <section class="section">
    <div class="wrap">
      <Display text="In-house R&D team" />
      <ul class="disc">
        {disciplines.map((d, i) => <li class="display display-sm" data-in style={`--i:${i}`}>{d}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight alt">
    <div class="wrap">
      <ul class="trio">
        {advantages.map((a, i) => <li data-in style={`--i:${i}`}><h3 class="h3">{a.title}</h3><p>{a.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="stick">
        <Display text="Product features" />
      </div>
      <ul class="rows feats">
        {productFeatures.map((f, i) => <li data-in style={`--i:${i % 6}`}>{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <Display text="Induction vs oil and gas furnaces" />
      <p class="lede lead" data-in>An induction billet heater compared with fuel-fired furnaces on the measures a forge shop tracks.</p>
      <div class="table-scroll" data-in>
        <table class="spec-table">
          <thead><tr>{comparison.headers.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>
            {comparison.rows.map((r) => <tr>{r.map((c, i) => <td class:list={[i === 1 && 'us']}>{c}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap vm">
      <div data-in><h2 class="h3">Vision</h2><p class="display display-sm">{visionMission.vision}</p></div>
      <div data-in style="--i:1"><h2 class="h3">Mission</h2><p class="display display-sm">{visionMission.mission}</p></div>
    </div>
  </section>

  <Enquiry />
</Layout>

<style>
  .story { display: grid; gap: clamp(2.5rem, 6vw, 6rem); }
  .text { display: flex; flex-direction: column; gap: 1.25rem; max-width: 40rem; }
  .big { font-size: clamp(1.35rem, 2.2vw, 1.85rem); line-height: 1.3; font-stretch: 90%; font-weight: 600; }
  .text p:not(.big) { color: var(--fg-2); }
  .glance { margin-top: 1.5rem; }
  .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-content: start; }
  .shot { overflow: hidden; border-radius: 3px; }
  .shot.a { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
  .shot.b { aspect-ratio: 1; }
  .disc { margin-top: clamp(2rem, 4vw, 3.5rem); display: flex; flex-wrap: wrap; gap: 0.5rem clamp(1.5rem, 4vw, 4rem); color: var(--cab); }
  .alt { background: var(--plate); border-block: 1px solid var(--line); }
  .trio { display: grid; gap: 2rem; }
  .trio p { color: var(--fg-2); margin-top: 0.5rem; max-width: 26rem; }
  @media (min-width: 900px) { .trio { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }
  .feats li { padding-block: 0.9rem; font-weight: 550; }
  .lead { margin-block: 1.5rem 2.5rem; }
  td.us { font-weight: 650; color: var(--cab-deep); }
  .vm { display: grid; gap: 3rem; }
  .vm h2 { color: var(--fg-3); font-weight: 500; font-size: 1rem; margin-bottom: 1rem; }
  @media (min-width: 1024px) {
    .story { grid-template-columns: 1.1fr 1fr; }
    .split { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(3rem, 6vw, 7rem); align-items: start; }
    .stick { position: sticky; top: calc(var(--nav-h) + 2rem); }
    .vm { grid-template-columns: 1fr 1fr; gap: 5rem; }
  }
  @media (max-width: 1023px) { .stick { margin-bottom: 2rem; } }
</style>
