---
import Layout from '../layouts/Layout.astro';
import EmberField from '../components/EmberField.astro';
import StatStrip from '../components/StatStrip.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import {
  company,
  products,
  capabilities,
  advantages,
  process,
  countries,
  clientLogos,
  testimonials,
  heroBanners,
  aboutImages,
} from '../data/site';
---

<Layout
  title="Supertherm Corporations — Induction Forging, Hardening, Melting & Welding Machines"
  description="Supertherm Corporations is a leading manufacturer & supplier of induction heating equipment — induction forging machines, hardening systems, medium-frequency melting furnaces and high-frequency welders. 30+ years, 1000+ machines delivered across Asia & the Gulf."
>
  <!-- ============ HERO ============ -->
  <section data-ondark class="relative flex min-h-[100svh] items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0" data-hero-carousel>
        {heroBanners.map((src, i) => (
          <div class:list={['hero-slide', { active: i === 0 }]} style={`background-image:url(${src})`} />
        ))}
      </div>
      <div class="absolute inset-0 bg-gradient-to-br from-molten-700/35 to-ink/25 mix-blend-multiply"></div>
      <EmberField class="z-[1] opacity-85" />
      <div class="glow-blob" style="width:600px;height:600px;background:#d63f00;left:8%;top:10%;opacity:0.22"></div>
      <div class="glow-blob" style="width:420px;height:420px;background:#ff9d3d;right:6%;bottom:6%;opacity:0.16;animation-delay:-4s"></div>
      <!-- vignette for text legibility -->
      <div
        class="absolute inset-0 bg-[linear-gradient(90deg,#0a0a0b_2%,rgba(10,10,11,0.4)_45%,transparent_75%),linear-gradient(0deg,#0a0a0b_4%,transparent_40%),radial-gradient(120%_90%_at_50%_30%,transparent_45%,#0a0a0b_96%)]"
      >
      </div>
    </div>

    <div class="relative z-[2] mx-auto w-full max-w-7xl px-5 pb-16 pt-24 sm:px-6" data-hero-content>
      <span
        class="inline-flex items-center gap-2.5 rounded-full border border-line bg-white/[0.03] px-4 py-2 text-[0.82rem] text-muted"
        data-reveal
      >
        <span class="h-2 w-2 rounded-full bg-molten-400 shadow-[0_0_12px_2px_theme(colors.molten.400)]"></span>
        Manufacturing excellence since {company.established}
      </span>

      <h1 class="mt-6 max-w-[18ch] text-[clamp(2.8rem,8vw,5.5rem)] font-bold leading-[1.02]">
        <span class="block" data-reveal>Precision heat,</span>
        <span class="text-gradient block" data-reveal style="--reveal-delay:120ms">forged into power.</span>
      </h1>

      <p class="mt-6 max-w-[40rem] text-[1.15rem] leading-7 text-muted" data-reveal style="--reveal-delay:240ms">
        {company.name} engineers world-class induction systems — hardening, forging, melting and
        high-frequency welding — built for the modern foundry and shop floor.
      </p>

      <div class="mt-9 flex flex-wrap gap-4" data-reveal style="--reveal-delay:340ms">
        <a href="/products" class="btn btn-primary" data-magnetic="0.4">
          Explore Products <Icon name="arrow" class="h-[1.15rem] w-[1.15rem]" />
        </a>
        <a href="/contact" class="btn btn-ghost" data-magnetic="0.3">Talk to an Engineer</a>
      </div>

      <div class="mt-12 flex flex-wrap gap-x-8 gap-y-4" data-reveal style="--reveal-delay:440ms">
        {[
          { icon: 'chip', label: 'IGBT up to 750 KW' },
          { icon: 'clock', label: '24/7 support' },
          { icon: 'globe', label: '9 countries served' },
        ].map((m) => (
          <div class="flex items-center gap-2 text-[0.9rem] text-muted">
            <Icon name={m.icon} class="h-5 w-5 text-molten-300" /><span>{m.label}</span>
          </div>
        ))}
      </div>
    </div>

    <a
      href="#products"
      class="absolute bottom-7 left-1/2 z-[2] grid h-[42px] w-[26px] -translate-x-1/2 place-items-start justify-items-center rounded-full border-2 border-line pt-2"
      aria-label="Scroll down"
    >
      <span class="h-2 w-1 animate-[scroll-cue_1.6s_infinite] rounded-full bg-molten-400"></span>
    </a>
  </section>

  <StatStrip />

  <!-- ============ PRODUCTS ============ -->
  <section id="products" class="py-24">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-6">
      <SectionHeading eyebrow="What we build" title="Induction systems, <span class='text-gradient'>engineered end to end</span>">
        From a single hardening station to a turnkey foundry, every machine is designed, built and
        commissioned in-house.
      </SectionHeading>

      <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {products.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ CAPABILITIES ============ -->
  <section class="border-y border-line bg-gradient-to-b from-ink-2 to-ink py-24">
    <div class="mx-auto grid w-full max-w-7xl gap-12 px-5 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <div>
        <SectionHeading eyebrow="Capabilities" title="One partner for<br />every heating process">
          Whatever the metallurgy, we have the coil, power source and automation to match.
        </SectionHeading>
        <a href="/products" class="btn btn-ghost mt-8" data-magnetic="0.3">
          See all products <Icon name="arrow" class="h-[1.15rem] w-[1.15rem]" />
        </a>
        <div class="relative mt-9 aspect-[16/10] overflow-hidden rounded-2xl border border-line" data-reveal="scale">
          <img
            src={aboutImages.capability}
            alt="Supertherm induction equipment"
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105"
          />
          <div class="absolute bottom-4 left-4 flex items-center gap-2 rounded-full border border-line bg-ink/70 px-4 py-2 text-[0.82rem] font-medium backdrop-blur">
            <Icon name="chip" class="h-[1.1rem] w-[1.1rem] text-molten-300" /><span>In-house manufacturing</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {capabilities.map((c, i) => (
          <div class="bg-ink p-[1.9rem] transition-colors duration-300 hover:bg-ink-3" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <Icon name="spark" class="h-6 w-6 text-molten-300" />
            <h3 class="mt-4 text-[1.15rem]">{c.title}</h3>
            <p class="mt-2 text-[0.92rem] leading-[1.6] text-muted">{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="py-24">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-6">
      <SectionHeading align="center" eyebrow="How we work" title="From brief to <span class='text-gradient'>running line</span>">
        A proven four-step path that de-risks your investment.
      </SectionHeading>

      <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {process.map((p, i) => (
          <div
            class="rounded-2xl border border-line bg-gradient-to-b from-white/[0.03] to-transparent p-7"
            data-reveal
            style={`--reveal-delay:${i * 100}ms`}
          >
            <div class="font-display text-[2.4rem] font-bold text-transparent [-webkit-text-stroke:1.5px_theme(colors.molten.500)]">{p.step}</div>
            <h3 class="mt-3 text-[1.2rem]">{p.title}</h3>
            <p class="mt-2 text-[0.92rem] leading-[1.6] text-muted">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ADVANTAGES ============ -->
  <section class="border-y border-line bg-gradient-to-b from-ink-2 to-ink py-24">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-6">
      <SectionHeading eyebrow="Why Supertherm" title="Built to run, backed for life">
        Thirty years of field experience baked into every machine — and a team that stays with you
        long after commissioning.
      </SectionHeading>

      <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {advantages.map((a, i) => (
          <div class="card card-glow p-8" data-tilt data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="grid h-[3.2rem] w-[3.2rem] place-items-center rounded-[0.9rem] border border-molten-300/[0.22] bg-gradient-to-br from-molten-300/[0.16] to-molten-500/[0.06]">
              <Icon name={a.icon} class="h-[1.7rem] w-[1.7rem] text-molten-300" />
            </span>
            <h3 class="mt-5 text-[1.2rem]">{a.title}</h3>
            <p class="mt-2.5 text-[0.93rem] leading-[1.65] text-muted">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ GLOBAL REACH ============ -->
  <section class="overflow-hidden py-24">
    <div class="mx-auto grid w-full max-w-7xl items-center gap-12 px-5 sm:px-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <SectionHeading eyebrow="Global footprint" title="Trusted across <span class='text-gradient'>Asia & the Gulf</span>">
          More than 1000 machines delivered and running across nine countries — and counting.
        </SectionHeading>
        <div class="mt-8 flex flex-wrap gap-2.5" data-reveal>
          {countries.map((c) => (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-line px-3.5 py-2 text-[0.88rem] text-muted transition-all duration-300 hover:border-molten-400 hover:text-fg">
              <Icon name="pin" class="h-[0.95rem] w-[0.95rem] text-molten-300" />{c}
            </span>
          ))}
        </div>
      </div>
      <div class="grid place-items-center" data-reveal="right">
        <div class="relative grid h-60 w-60 place-items-center rounded-full border border-line bg-[radial-gradient(circle_at_40%_35%,rgba(255,157,61,0.22),transparent_60%)]">
          <Icon name="globe" class="h-28 w-28 text-molten-300" />
          <span class="absolute inset-0 animate-[pulse-ring_3s_infinite] rounded-full border border-molten-500"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CLIENTS MARQUEE ============ -->
  <section class="overflow-hidden border-y border-line bg-ink-2 py-12">
    <p class="mx-auto mb-7 w-full max-w-7xl px-6 text-center text-[0.78rem] uppercase tracking-[0.2em] text-faint" data-reveal>
      Chosen by leading manufacturers
    </p>
    <div class="[mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]">
      <div class="marquee-track gap-4">
        {[...clientLogos, ...clientLogos].map((src, i) => (
          <span class="flex h-20 w-40 flex-none items-center justify-center rounded-xl bg-white p-4">
            <img src={src} alt={`Client ${(i % clientLogos.length) + 1}`} loading="lazy" class="max-h-full max-w-full object-contain" />
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="border-b border-line bg-gradient-to-b from-ink-2 to-ink py-24">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-6">
      <SectionHeading align="center" eyebrow="In their words" title="What the shop floor says" />
      <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
        {testimonials.map((t, i) => (
          <figure class="card p-8" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="font-display text-[3.5rem] leading-[0.6] text-molten-500/50">&ldquo;</div>
            <blockquote class="mt-4 text-[1.02rem] leading-7">{t.quote}</blockquote>
            <figcaption class="mt-5 flex flex-col">
              <strong class="text-[0.95rem]">{t.name}</strong>
              <span class="text-[0.85rem] text-molten-300">{t.org}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<script>
  // Hero banner crossfade carousel
  const slides = document.querySelectorAll<HTMLElement>('[data-hero-carousel] .hero-slide');
  if (slides.length > 1) {
    let idx = 0;
    setInterval(() => {
      slides[idx].classList.remove('active');
      idx = (idx + 1) % slides.length;
      slides[idx].classList.add('active');
    }, 6000);
  }
</script>
