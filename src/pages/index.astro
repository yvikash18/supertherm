---
import Layout from '../layouts/Layout.astro';
import Display from '../components/Display.astro';
import HeatLine from '../components/HeatLine.astro';
import Plate from '../components/Plate.astro';
import Glyph from '../components/Glyph.astro';
import SizingTool from '../components/SizingTool.astro';
import Compare from '../components/Compare.astro';
import ProcessAnim from '../components/ProcessAnim.astro';
import Enquiry from '../components/Enquiry.astro';
import { products, process, countries, clientLogos, branches, aboutImages, advantages, testimonials, divisions } from '../data/content';
import { company } from '../data/content';
import { si, tel } from '../lib/format';

const { noindex = false } = Astro.props;

const statement =
  'An induction coil never touches the metal: the steel heats itself. No flame, no warm-up, every billet the same. More than 1000 Supertherm machines run across nine countries.';
---

<Layout
  darkHero
  noindex={noindex}
  title="Supertherm Corporations | Induction Forging, Hardening, Melting & Welding Machines"
  description="Supertherm Corporations is a leading manufacturer & supplier of induction heating equipment — induction forging machines, hardening systems, medium-frequency melting furnaces and high-frequency welders. 30+ years, 1000+ machines delivered across Asia & the Gulf."
>
  <!-- Hero: the line running -->
  <section class="on-night hero">
    <div class="wrap top">
      <Display as="h1" text="Induction heat for forging, hardening, melting and welding." class="display-xl" onload delay={150} />
      <div class="sub" data-in style="--i:8">
        <p class="lede">Machines from 50 to 2000 kW, designed and built at our works in Bahadurgarh, Haryana for more than 30 years.</p>
        <div class="acts">
          <a href="#size" class="btn btn-solid">Find your machine</a>
          <a href={`tel:${company.phoneRaw}`} class="btn btn-line num">Call {company.phone}</a>
        </div>
      </div>
    </div>
    <HeatLine />
  </section>

  <!-- What induction is, in one pass -->
  <section class="statement" data-statement>
    <div class="wrap">
      <p>{statement.split(' ').map((w) => (<><span class="sw">{w}</span>{' '}</>))}</p>
      <div class="gauge" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <Plate />

  <!-- Machines -->
  <section class="section" id="machines">
    <div class="wrap">
      <div class="head">
        <Display text="Four machine families" />
        <p class="lede" data-in>Each one is engineered to the part: coil, power source, handling and controls come from the same works.</p>
      </div>
      <ul class="rows machines">
        {products.map((p, i) => (
          <li data-in style={`--i:${i}`}>
            <a href={`/products#${p.slug}`} data-preview={p.image}>
              <Glyph name={p.icon} class="glyph" />
              <div class="name">
                <h3 class="display display-sm">{p.name}</h3>
                <p>{si(p.series)}</p>
              </div>
              <ul class="specs num">{p.specs.slice(0, 2).map((s) => <li>{si(s)}</li>)}</ul>
              <span class="go">Specifications</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Everything the two divisions build -->
  <section class="section-tight range">
    <div class="wrap">
      <div class="divs">
        {divisions.map((d, i) => (
          <div data-in style={`--i:${i}`}><h3 class="h3">{d.title}</h3><ul>{d.items.map((x) => <li>{x}</li>)}</ul></div>
        ))}
      </div>
    </div>
  </section>

  <!-- The four processes, animated (stands in for the process video on the old site) -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <Display text="The work, as it happens" />
        <p class="lede" data-in>What each machine does to the steel, drawn step by step. Pick a process. <a class="link" href="/products">Machine specifications</a></p>
      </div>
      <div data-in><ProcessAnim kinds={['hardening', 'forge', 'melt', 'weld']} /></div>
    </div>
  </section>

  <!-- Sizing tool -->
  <section class="section size" id="size">
    <div class="wrap">
      <div class="head">
        <Display text="Size it by the bar" />
        <p class="lede" data-in>Frequency decides how deep the current heats. Thin bar needs high frequency, heavy billet needs low. Drag to your diameter.</p>
      </div>
      <div data-in><SizingTool /></div>
    </div>
  </section>

  <!-- Against fuel-fired furnaces -->
  <section class="section">
    <div class="wrap split">
      <div class="head stick">
        <Display text="Against oil and gas" />
        <p class="lede" data-in>What changes when a forge shop replaces a fuel-fired furnace with an induction billet heater.</p>
        <p class="note" data-in>Supertherm figures for billet heating, with electricity at ₹7 per unit.</p>
      </div>
      <Compare />
    </div>
  </section>

  <!-- From enquiry to running line -->
  <section class="section works">
    <div class="wrap">
      <div class="head two">
        <Display text="From drawing to running line" />
        <div class="shot" data-wipe><img class="photo" src={aboutImages.capability} alt="A Supertherm billet heater with its control cabinet on the works floor" loading="lazy" width="1200" height="900" /></div>
      </div>
      <ol class="steps">
        {process.map((s, i) => (
          <li data-in style={`--i:${i}`}>
            <span class="figure num">{i + 1}</span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- After delivery -->
  <section class="section-tight after">
    <div class="wrap">
      <ul class="trio">
        {advantages.map((a, i) => (
          <li data-in style={`--i:${i}`}><h3 class="h3">{a.title}</h3><p>{a.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Clients -->
  <section class="section clients">
    <div class="wrap">
      <div class="head">
        <Display text="Running in these plants" />
        <p class="lede" data-in>Forging shops, gear makers and two-wheeler plants that heat with Supertherm machines. <a class="link" href="/clients">All clients</a></p>
      </div>
      <ul class="logos">
        {clientLogos.slice(0, 15).map((src, i) => (
          <li data-in style={`--i:${i % 5}`}><img src={src} alt="" loading="lazy" width="436" height="300" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- What customers say -->
  <section class="section said">
    <div class="wrap">
      <Display text="What customers say" />
      <ul class="quotes">
        {testimonials.map((t, i) => (
          <li data-in style={`--i:${i}`}>
            <blockquote>{si(t.quote)}</blockquote>
            <p>{t.name}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Service network -->
  <section class="section net">
    <div class="wrap split">
      <div class="head stick">
        <Display text="Service within reach" />
        <p class="lede" data-in>Seven offices across India and a service line that answers day and night. Machines delivered to {countries.slice(1, -1).join(', ')} and {countries[countries.length - 1]}.</p>
        <a class="btn btn-line" href="/branches" data-in>Addresses and contacts</a>
      </div>
      <ul class="rows offices">
        {branches.map((b, i) => (
          <li data-in style={`--i:${i}`}>
            <span class="city display display-sm">{b.city}</span>
            <span class="role">{b.role}<br />{b.region}</span>
            <a class="num" href={`tel:${tel(b.phones[b.phones.length > 1 ? 1 : 0])}`}>{b.phones[b.phones.length > 1 ? 1 : 0]}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Enquiry />
</Layout>

<style>
  /* Hero */
  .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: space-between; padding-top: calc(var(--nav-h) + clamp(1.5rem, 4vh, 3.5rem)); padding-bottom: 1.25rem; overflow: hidden; }
  .hero :global(h1) { font-size: clamp(2.9rem, min(9.4vw, 15.5vh), 11rem); }
  .sub { display: grid; gap: 1.5rem; margin-top: clamp(1.5rem, 3vh, 2.5rem); margin-bottom: clamp(1rem, 2vh, 2rem); align-items: end; }
  .acts { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (min-width: 900px) { .sub { grid-template-columns: minmax(0, 34rem) auto; justify-content: space-between; } }
  @media (max-width: 520px) { .acts .btn { width: 100%; } }

  /* Statement */
  .statement { min-height: 100svh; display: flex; align-items: center; padding-block: clamp(4rem, 10vh, 7rem); }
  .statement p { font-stretch: 78%; font-weight: 650; font-size: clamp(1.7rem, 4.3vw, 4rem); line-height: 1.08; letter-spacing: -0.01em; max-width: 22em; text-wrap: pretty; }
  .statement.is-armed .sw { color: var(--rule); transition: color 0.45s; }
  .statement.is-armed .sw.is-hot { color: var(--h900); transition-duration: 0.08s; }
  .statement.is-armed .sw.is-lit { color: var(--steel); }
  .gauge { display: none; margin-top: clamp(2rem, 5vh, 4rem); height: 3px; background: var(--rule); max-width: 22rem; }
  .gauge span { display: block; height: 100%; background: linear-gradient(90deg, var(--h700), var(--h900), var(--h1100)); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .statement.is-armed .gauge { display: block; }

  /* Section heads */
  .head { display: grid; gap: 1.5rem; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  @media (min-width: 1024px) {
    .head:not(.stick) { grid-template-columns: 1.5fr 1fr; align-items: end; gap: 4rem; }
    .split { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(3rem, 6vw, 7rem); align-items: start; }
    .stick { position: sticky; top: calc(var(--nav-h) + 2rem); margin-bottom: 0; justify-items: start; }
  }

  /* Machine rows */
  .machines a { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.75rem 1.25rem; align-items: center; padding-block: 1.5rem; transition: background-color 0.2s, padding 0.35s var(--ease); }
  .machines :global(.glyph) { width: 5.5rem; height: auto; }
  .name p { color: var(--fg-2); margin-top: 0.4rem; }
  .specs { grid-column: 2; display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; font-weight: 600; }
  .go { display: none; }
  @media (min-width: 1024px) {
    .machines a { grid-template-columns: 10rem 1.5fr 1fr auto; gap: 2.5rem; padding-block: 2rem; }
    .machines :global(.glyph) { width: 10rem; }
    .specs { grid-column: auto; flex-direction: column; }
    .go { display: block; color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
    .machines a:hover { background: var(--plate); padding-inline: 1.5rem; }
    .machines a:hover .go { text-decoration-thickness: 2px; }
  }

  /* Division lists */
  .range { padding-top: 0; }
  .divs { display: grid; gap: 2.5rem; }
  .divs h3 { padding-bottom: 0.75rem; border-bottom: 1px solid var(--fg); margin-bottom: 0.75rem; }
  .divs ul { columns: 2; column-gap: 2rem; }
  .divs li { padding-block: 0.35rem; break-inside: avoid; color: var(--fg-2); }
  @media (min-width: 900px) { .divs { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  @media (max-width: 480px) { .divs ul { columns: 1; } }

  /* Sizing */
  .size { background: var(--plate); border-block: 1px solid var(--line); }

  /* Steps */
  .head.two .shot { aspect-ratio: 4 / 3; overflow: hidden; border-radius: 3px; max-width: 34rem; justify-self: end; width: 100%; }
  .steps { display: grid; gap: 2rem; counter-reset: s; }
  .steps li { border-top: 1px solid var(--fg); padding-top: 1rem; }
  .steps .figure { color: var(--cab); display: block; margin-bottom: 1.25rem; }
  .steps p { color: var(--fg-2); margin-top: 0.5rem; max-width: 22rem; }
  @media (min-width: 700px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; } }

  /* Support, training, R&D */
  .after { background: var(--plate); border-block: 1px solid var(--line); }
  .trio { display: grid; gap: 2rem; }
  .trio p { color: var(--fg-2); margin-top: 0.5rem; max-width: 26rem; }
  @media (min-width: 900px) { .trio { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  /* Testimonials */
  .quotes { display: grid; gap: 2.5rem; margin-top: clamp(2.5rem, 5vw, 4.5rem); }
  .quotes li { border-top: 1px solid var(--fg); padding-top: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; }
  .quotes blockquote { font-size: 1.2rem; line-height: 1.4; font-stretch: 92%; font-weight: 500; }
  .quotes p { font-weight: 700; }
  @media (min-width: 1000px) { .quotes { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  /* Logos: supplied on white, so multiply drops the white into the plate */
  .clients { background: #fff; border-block: 1px solid var(--line); }
  .logos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .logos li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); aspect-ratio: 3 / 2; display: grid; place-items: center; padding: 12%; min-width: 0; }
  .logos img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; filter: grayscale(1) contrast(1.05); transition: filter 0.3s; }
  .logos li:hover img { filter: none; }
  @media (min-width: 800px) { .logos { grid-template-columns: repeat(5, minmax(0, 1fr)); } }

  /* Offices */
  .offices li { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 1.5rem; padding-block: 1.1rem; align-items: baseline; }
  .offices .city { font-size: clamp(1.75rem, 3vw, 2.6rem); }
  .offices .role { color: var(--fg-3); font-size: 0.9375rem; grid-column: 1; }
  .offices a { grid-row: 1; grid-column: 2; font-weight: 600; }
  .offices a:hover { color: var(--accent); }
  @media (min-width: 700px) {
    .offices li { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) auto; }
    .offices .role { grid-column: auto; }
    .offices a { grid-row: auto; grid-column: auto; }
  }
</style>
