---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Enquiry from '../components/Enquiry.astro';
import { galleryImages } from '../data/content';
import { company, heroFor } from '../data/content';

const hero = heroFor('gallery');
---

<Layout title={`Gallery | ${company.name}`} description="Photographs of Supertherm induction forging, hardening, melting and welding machines at the works and on customer shop floors.">
  <PageHero title={hero.title} subtitle={hero.subtitle} />

  <section class="section-tight">
    <div class="wrap">
      <ul class="grid" data-gallery>
        {galleryImages.map((g, i) => (
          <li>
            <button type="button" data-src={g.src} data-n={i + 1} aria-label={`Enlarge photo ${i + 1} of ${galleryImages.length}`} data-wipe>
              <img class="photo" src={g.src} alt={`Supertherm machine photograph ${i + 1}`} loading="lazy" width="626" height="417" />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lb on-night" data-lightbox aria-label="Photo viewer">
    <img data-lb-img alt="" />
    <div class="lb-bar">
      <span class="num" data-lb-count></span>
      <div>
        <button type="button" data-lb-prev>Previous</button>
        <button type="button" data-lb-next>Next</button>
        <button type="button" data-lb-close>Close</button>
      </div>
    </div>
  </dialog>

  <Enquiry />
</Layout>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(0.5rem, 1.2vw, 1rem); }
  .grid button { display: block; width: 100%; aspect-ratio: 3 / 2; overflow: hidden; border-radius: 3px; cursor: zoom-in; }
  .grid button:hover { opacity: 0.88; }
  .grid button { transition: opacity 0.2s; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1200px) { .grid { grid-template-columns: repeat(4, 1fr); } }

  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: var(--pad); border: 0; background: var(--night); }
  .lb[open] { display: flex; flex-direction: column; gap: 1rem; }
  .lb::backdrop { background: var(--night); }
  .lb img { flex: 1; min-height: 0; width: 100%; object-fit: contain; }
  .lb-bar { display: flex; justify-content: space-between; align-items: center; color: var(--fg-2); }
  .lb-bar div { display: flex; gap: 1.5rem; }
  .lb-bar button { color: var(--fg); font-weight: 600; padding: 0.5rem 0; border-bottom: 1px solid transparent; }
  .lb-bar button:hover { border-bottom-color: currentColor; }
</style>

<script>
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery] button')];
  const lb = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = lb?.querySelector<HTMLImageElement>('[data-lb-img]');
  const count = lb?.querySelector<HTMLElement>('[data-lb-count]');
  let current = 0;
  const show = (i: number) => {
    current = (i + tiles.length) % tiles.length;
    if (img) { img.src = tiles[current].dataset.src || ''; img.alt = `Supertherm machine photograph ${current + 1}`; }
    if (count) count.textContent = `${current + 1} / ${tiles.length}`;
  };
  tiles.forEach((t, i) => t.addEventListener('click', () => { show(i); lb?.showModal(); }));
  lb?.querySelector('[data-lb-close]')?.addEventListener('click', () => lb.close());
  lb?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
  lb?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
  lb?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });
  lb?.addEventListener('close', () => tiles[current]?.focus());
</script>
