---
import Layout from '../layouts/Layout.astro';
import Display from '../components/Display.astro';
import { company } from '../data/content';
---

<Layout title={`Page not found | ${company.name}`}>
  <section class="nf">
    <div class="wrap">
      <Display as="h1" text="This page has gone cold." class="display-xl" onload />
      <p class="lede">The address may have changed when the site was rebuilt. The machines and contact details are all still here.</p>
      <div class="acts">
        <a href="/products" class="btn btn-solid">See the machines</a>
        <a href="/" class="btn btn-line">Go to the home page</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf { min-height: 80svh; display: flex; align-items: center; padding-top: calc(var(--nav-h) + 3rem); padding-bottom: 4rem; }
  .lede { margin-block: 2rem; }
  .acts { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
