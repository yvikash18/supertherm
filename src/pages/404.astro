---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Page not found — Supertherm Corporations">
  <section class="relative grid min-h-[78vh] place-items-center overflow-hidden text-center">
    <div class="glow-blob" style="width:420px;height:420px;background:#f75d02;left:50%;top:40%;transform:translate(-50%,-50%);opacity:0.22"></div>
    <div class="relative max-w-lg px-5 pt-20 sm:px-6">
      <span class="bg-gradient-to-br from-molten-300 to-molten-600 bg-clip-text font-display text-[clamp(5rem,18vw,10rem)] font-bold leading-none text-transparent">404</span>
      <h1 class="mt-4 text-[clamp(1.6rem,4vw,2.4rem)] font-bold">This page cooled down and left</h1>
      <p class="mt-4 leading-7 text-muted">The page you're after doesn't exist or has moved. Let's get you back on track.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-primary" data-magnetic="0.35">Back home <Icon name="arrow" class="h-[1.15rem] w-[1.15rem]" /></a>
        <a href="/products" class="btn btn-ghost" data-magnetic="0.3">View products</a>
      </div>
    </div>
  </section>
</Layout>
