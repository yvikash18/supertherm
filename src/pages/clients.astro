---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Display from '../components/Display.astro';
import Plate from '../components/Plate.astro';
import Enquiry from '../components/Enquiry.astro';
import { clientSectors, clientLogos, testimonials } from '../data/content';
import { si } from '../lib/format';
import { company, heroFor } from '../data/content';

const hero = heroFor('clients');
---

<Layout title={`Clients | ${company.name}`} description="Trusted by leading forging, foundry, fastener and tube-mill manufacturers across Asia and the Gulf.">
  <PageHero title={hero.title} subtitle={hero.subtitle} />

  <section class="section-tight logos-sec">
    <div class="wrap">
      <ul class="logos">
        {clientLogos.map((src, i) => (
          <li data-in style={`--i:${i % 5}`}><img src={src} alt={`Supertherm client logo ${i + 1}`} loading="lazy" width="436" height="300" /></li>
        ))}
      </ul>
    </div>
  </section>

  <Plate />

  <section class="section">
    <div class="wrap split">
      <Display text="Industries we heat for" />
      <ul class="rows sectors">
        {clientSectors.map((s, i) => <li data-in style={`--i:${i % 5}`}>{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="section said">
    <div class="wrap">
      <Display text="What customers say" />
      <ul class="quotes">
        {testimonials.map((t, i) => (
          <li data-in style={`--i:${i}`}><blockquote>{si(t.quote)}</blockquote><p>{t.name}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <Enquiry title="Put a Supertherm on your line." text="Tell us the part and the output you need. We will size the machine and quote it." />
</Layout>

<style>
  .logos-sec { background: #fff; }
  .logos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .logos li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); aspect-ratio: 3 / 2; display: grid; place-items: center; padding: 12%; min-width: 0; }
  .logos img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .said { background: var(--plate); border-top: 1px solid var(--line); }
  .quotes { display: grid; gap: 2.5rem; margin-top: clamp(2.5rem, 5vw, 4.5rem); }
  .quotes li { border-top: 1px solid var(--fg); padding-top: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; }
  .quotes blockquote { font-size: 1.2rem; line-height: 1.4; font-stretch: 92%; font-weight: 500; }
  .quotes p { font-weight: 700; }
  @media (min-width: 1000px) { .quotes { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }
  .sectors li { padding-block: 0.9rem; font-size: 1.25rem; font-stretch: 90%; font-weight: 600; }
  @media (min-width: 640px) { .logos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .logos { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .split { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  }
  @media (max-width: 1023px) { .sectors { margin-top: 2rem; } }
</style>
