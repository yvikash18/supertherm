---
// Display headline. Each word sits in its own mask and rises into place,
// so the text wraps naturally at any width.
interface Props {
  text: string;
  as?: string;
  class?: string;
  delay?: number;
  /** Play on page load instead of when scrolled into view. */
  onload?: boolean;
}
const { text, as: Tag = 'h2', class: cls = '', delay = 0, onload = false } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
---

<Tag class={`display rise ${cls}`} data-rise={onload ? 'load' : 'view'} style={`--d:${delay}ms`}>
  {words.map((w, i) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}
</Tag>
