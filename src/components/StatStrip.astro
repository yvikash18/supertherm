---
import { stats } from '../data/site';
---

<section class="relative border-y border-line bg-gradient-to-b from-ink-2 to-ink">
  <div class="mx-auto grid w-full max-w-7xl grid-cols-2 gap-px bg-line md:grid-cols-4">
    {
      stats.map((s, i) => (
        <div class="bg-ink px-6 py-10 text-center md:py-[3.25rem]" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <div class="bg-gradient-to-br from-white to-molten-300 bg-clip-text font-display text-[clamp(2.4rem,6vw,3.6rem)] font-bold leading-none text-transparent">
            <span data-counter={s.value} data-suffix={s.suffix}>0</span>
          </div>
          <div class="mt-3 text-[0.98rem] font-semibold">{s.label}</div>
          <div class="mt-1.5 text-[0.82rem] text-faint">{s.sub}</div>
        </div>
      ))
    }
  </div>
</section>
