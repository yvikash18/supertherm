---
import { company } from '../data/site';
import Icon from './Icon.astro';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to heat up your production line?',
  text = 'Tell us your part, tonnage and cycle-time targets — our engineers will design the right induction system for you.',
} = Astro.props;
---

<section class="relative overflow-hidden py-20">
  <div
    class="glow-blob"
    style="width:520px;height:520px;background:#f75d02;left:50%;top:50%;transform:translate(-50%,-50%);opacity:0.25"
  >
  </div>
  <div
    class="card card-glow relative mx-auto flex w-full max-w-7xl flex-col gap-8 bg-gradient-to-br from-ink-3 to-ink-2 px-6 py-12 md:flex-row md:items-center md:justify-between md:px-[3.25rem] md:py-[3.75rem]"
    data-reveal="scale"
  >
    <div>
      <span class="eyebrow">Let's build</span>
      <h2 class="mt-3.5 max-w-[22ch] text-[clamp(1.7rem,4vw,2.6rem)] font-bold leading-[1.1]">{title}</h2>
      <p class="mt-4 max-w-[46ch] leading-7 text-muted">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3.5">
      <a href="/contact" class="btn btn-primary" data-magnetic="0.4">
        Request a Quote <Icon name="arrow" class="h-[1.15rem] w-[1.15rem]" />
      </a>
      <a href={`tel:${company.phoneRaw}`} class="btn btn-ghost" data-magnetic="0.3">
        <Icon name="phone" class="h-[1.15rem] w-[1.15rem]" /> {company.phone}
      </a>
    </div>
  </div>
</section>
