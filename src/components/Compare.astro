---
// Induction billet heater against oil- and gas-fired furnaces.
// Figures are Supertherm's own (src/data/site.ts → comparison).
const fuels = ['Induction', 'Oil fired', 'Gas fired'];
const metrics = [
  { name: 'Running cost', unit: 'per kg heated', values: [3, 5.6, 5], fmt: (v: number) => `₹${v}` },
  { name: 'Steel lost to scale', unit: 'of the billet', values: [0.8, 4.5, 3.4], fmt: (v: number) => `${v}%` },
  { name: 'Temperature spread', unit: 'across the billet', values: [25, 75, 75], fmt: (v: number) => `±${v} °C` },
];
const startup = ['Instant, 1 to 2 minutes', 'At least 1 hour', '1 hour'];
---

<div class="cmp" data-bars>
  {metrics.map((m) => {
    const max = Math.max(...m.values);
    return (
      <figure>
        <figcaption><strong>{m.name}</strong> <span>{m.unit}</span></figcaption>
        {m.values.map((v, i) => (
          <div class:list={['bar', i === 0 && 'us']}>
            <span class="lab">{fuels[i]}</span>
            <span class="track"><span class="bar-fill" style={`width:${(v / max) * 100}%;--k:${i}`}></span></span>
            <span class="val num">{m.fmt(v)}</span>
          </div>
        ))}
      </figure>
    );
  })}
  <figure>
    <figcaption><strong>Time to start</strong> <span>from cold</span></figcaption>
    {startup.map((s, i) => (
      <div class:list={['bar text', i === 0 && 'us']}><span class="lab">{fuels[i]}</span><span class="val">{s}</span></div>
    ))}
  </figure>
</div>

<style>
  .cmp { display: grid; gap: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 5vw, 5rem); }
  figcaption { padding-bottom: 0.75rem; margin-bottom: 0.75rem; border-bottom: 1px solid var(--fg); }
  figcaption strong { font-size: 1.25rem; font-stretch: 88%; }
  figcaption span { color: var(--fg-3); font-size: 0.9375rem; margin-left: 0.4rem; }
  .bar { display: grid; grid-template-columns: 5.5rem 1fr 5rem; align-items: center; gap: 0.75rem; padding-block: 0.4rem; color: var(--fg-2); }
  .bar.text { grid-template-columns: 5.5rem 1fr; }
  .bar.us { color: var(--fg); font-weight: 650; }
  .track { height: 1.1rem; }
  .bar-fill { display: block; height: 100%; background: var(--steel-3); transform-origin: left; transition: transform 1.1s var(--ease); transition-delay: calc(var(--k) * 110ms); border-radius: 1px; }
  .us .bar-fill { background: var(--cab); }
  .val { text-align: right; }
  .text .val { text-align: left; }
  @media (min-width: 900px) { .cmp { grid-template-columns: 1fr 1fr; } }
</style>
