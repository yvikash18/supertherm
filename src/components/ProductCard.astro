---
import Icon from './Icon.astro';
interface Props {
  product: {
    slug: string;
    name: string;
    series: string;
    tag: string;
    icon: string;
    image?: string;
    blurb: string;
    specs: string[];
  };
  index?: number;
}
const { product, index = 0 } = Astro.props;
---

<article
  id={product.slug}
  class="card card-glow group flex h-full flex-col"
  data-tilt
  data-reveal
  style={`--reveal-delay:${index * 90}ms`}
>
  {
    product.image && (
      <div class="relative aspect-[16/11] overflow-hidden after:absolute after:inset-0 after:bg-gradient-to-b after:from-transparent after:to-ink-3/90">
        <img
          src={product.image}
          alt={product.name}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.07]"
        />
        <span class="absolute left-3.5 top-3.5 z-10 rounded-full border border-line bg-ink/65 px-2.5 py-1 text-[0.72rem] uppercase tracking-[0.14em] text-faint backdrop-blur">
          {product.tag}
        </span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-[1.6rem]">
    <span class="mb-4 grid h-[3.1rem] w-[3.1rem] place-items-center rounded-[0.9rem] border border-molten-300/25 bg-gradient-to-br from-molten-300/[0.18] to-molten-500/[0.08]">
      <Icon name={product.icon} class="h-6 w-6 text-molten-300" />
    </span>

    <h3 class="text-[1.4rem] font-bold">{product.name}</h3>
    <p class="mt-1 text-[0.85rem] font-medium text-molten-300">{product.series}</p>
    <p class="mt-3.5 text-[0.93rem] leading-[1.65] text-muted">{product.blurb}</p>

    <ul class="my-5 flex flex-col gap-[0.55rem]">
      {
        product.specs.map((s) => (
          <li class="flex items-center gap-[0.55rem] text-[0.88rem]">
            <Icon name="check" class="h-4 w-4 shrink-0 text-molten-400" />
            {s}
          </li>
        ))
      }
    </ul>

    <a
      href={`/products#${product.slug}`}
      class="heat-underline mt-auto inline-flex w-fit items-center gap-1.5 text-[0.9rem] font-semibold text-fg"
    >
      Learn more
      <Icon name="arrow" class="h-[1.05rem] w-[1.05rem] transition-transform duration-300 group-hover:translate-x-1" />
    </a>
  </div>
</article>
