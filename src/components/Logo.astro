---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---

<a href="/" class={`logo ${cls}`} aria-label="Supertherm Corporations, home">
  <img src="/assets/logo.png" alt="Supertherm Corporations" width="220" height="50" />
</a>

<style>
  /* The mark is supplied on white, so it sits on a white plate like a badge on a cabinet door. */
  .logo { display: inline-flex; background: #fff; padding: 0.4rem 0.6rem; border-radius: 3px; flex: none; }
  .logo img { height: 1.75rem; width: auto; display: block; }
</style>
