---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <span class="eyebrow" data-reveal>{eyebrow}</span>}
  <h2
    class="mt-4 text-[clamp(1.9rem,4.5vw,3rem)] font-bold leading-[1.08]"
    data-reveal
    style="--reveal-delay:80ms"
    set:html={title}
  />
  {
    Astro.slots.has('default') && (
      <p class="mt-[1.1rem] text-lg leading-7 text-muted" data-reveal style="--reveal-delay:160ms">
        <slot />
      </p>
    )
  }
</div>
