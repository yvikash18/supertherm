---
import Display from './Display.astro';
interface Props { eyebrow?: string; title: string; subtitle?: string }
const { title, subtitle } = Astro.props;
const path = Astro.url.pathname;
const segments = path.split('/').filter(Boolean);
const cap = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const crumbs = [
  { label: 'Home', href: '/' },
  ...segments.map((seg, i) => ({ label: cap(seg), href: '/' + segments.slice(0, i + 1).join('/') })),
];
const site = 'https://www.superthermcorporations.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: site + c.href })),
};
---

<section class="ph">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="wrap">
    <nav aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c, i) => (
          <li>
            {i > 0 && <span aria-hidden="true">/</span>}
            {i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
    <Display as="h1" text={title} class="display-xl" onload />
    {subtitle && <p class="lede" data-in>{subtitle}</p>}
  </div>
</section>

<style>
  .ph { padding-top: calc(var(--nav-h) + clamp(2.5rem, 6vw, 5rem)); padding-bottom: clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--line); }
  ol { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.9375rem; color: var(--fg-3); margin-bottom: 1.5rem; }
  li { display: flex; gap: 0.5rem; }
  ol a:hover { color: var(--fg); text-decoration: underline; }
  [aria-current] { color: var(--fg); }
  .lede { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
</style>
