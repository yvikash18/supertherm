---
import { nav, company } from '../data/site';
import Logo from './Logo.astro';
import Toolbar from './Toolbar.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background,border-color,backdrop-filter] duration-[400ms] [&.is-scrolled]:border-line [&.is-scrolled]:bg-ink/70 [&.is-scrolled]:backdrop-blur-xl"
>
  <div data-topbar class="mx-auto flex h-[4.75rem] w-full max-w-[1700px] items-center justify-between px-5 sm:px-8 lg:px-12 xl:px-16">
    <Logo />

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'heat-underline text-[0.92rem] font-medium transition-colors',
              isActive(item.href) ? 'text-fg [&::after]:w-full' : 'text-muted hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <Toolbar class="hidden lg:flex" />
      <a href={`tel:${company.phoneRaw}`} class="hidden items-center gap-2 text-[0.85rem] font-medium text-muted xl:inline-flex">
        <span class="h-2 w-2 animate-[pulse-ring_1.8s_infinite] rounded-full bg-emerald-400"></span>
        {company.phone}
      </a>
      <a href="/contact" class="btn btn-primary px-4 py-2 text-[0.85rem]" data-magnetic="0.3">Get a Quote</a>

      <button
        data-nav-toggle
        class="grid h-11 w-11 place-content-center gap-[5px] rounded-xl border border-line bg-white/[0.02] lg:hidden [&.is-open>span:nth-child(1)]:translate-y-[7px] [&.is-open>span:nth-child(1)]:rotate-45 [&.is-open>span:nth-child(2)]:opacity-0 [&.is-open>span:nth-child(3)]:-translate-y-[7px] [&.is-open>span:nth-child(3)]:-rotate-45"
        aria-label="Toggle menu"
      >
        <span class="block h-0.5 w-5 bg-fg transition-transform"></span>
        <span class="block h-0.5 w-5 bg-fg transition-opacity"></span>
        <span class="block h-0.5 w-5 bg-fg transition-transform"></span>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div
    data-nav-panel
    class="fixed inset-x-0 top-[4.75rem] flex -translate-y-[120%] flex-col gap-1 border-b border-line bg-ink/[0.97] p-6 backdrop-blur-xl transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] [&.is-open]:translate-y-0 lg:hidden"
  >
    <nav class="flex flex-col" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'border-b border-line px-1 py-3.5 font-display text-xl font-semibold',
              isActive(item.href) ? 'text-molten-300' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href="/contact" class="btn btn-primary mt-5 justify-center">Get a Quote</a>
    <Toolbar class="mt-4 justify-center" />
    <a href={`tel:${company.phoneRaw}`} class="mt-3.5 text-center text-[0.9rem] text-muted">{company.phone}</a>
  </div>
</header>
