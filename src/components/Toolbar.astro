---
import Icon from './Icon.astro';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

// Google-Translate language codes → native labels.
const langs: [string, string][] = [
  ['en', 'English'],
  ['hi', 'हिन्दी'],
  ['pa', 'ਪੰਜਾਬੀ'],
  ['gu', 'ગુજરાતી'],
  ['mr', 'मराठी'],
  ['ta', 'தமிழ்'],
  ['te', 'తెలుగు'],
  ['bn', 'বাংলা'],
  ['ar', 'العربية'],
  ['fa', 'فارسی'],
  ['ne', 'नेपाली'],
  ['ms', 'Melayu'],
  ['vi', 'Tiếng Việt'],
  ['zh-CN', '中文'],
  ['fr', 'Français'],
  ['es', 'Español'],
  ['de', 'Deutsch'],
  ['ru', 'Русский'],
];
---

<div class={`flex items-center gap-2 ${className}`} translate="no">
  <!-- Language -->
  <div class="relative">
    <span class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2">
      <Icon name="globe" class="h-4 w-4 text-molten-300" />
    </span>
    <select
      data-lang
      aria-label="Select language"
      class="notranslate cursor-pointer appearance-none rounded-lg border border-line bg-ink/40 py-2 pl-8 pr-7 text-[0.82rem] font-medium text-fg transition-colors hover:border-molten-400 focus:border-molten-400 focus:outline-none"
    >
      {langs.map(([code, label]) => <option value={code}>{label}</option>)}
    </select>
    <span class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2">
      <Icon name="chevron" class="h-3.5 w-3.5 text-faint" />
    </span>
  </div>

  <!-- Theme toggle -->
  <button
    data-theme-toggle
    aria-label="Toggle light or dark theme"
    class="grid h-9 w-9 place-items-center rounded-lg border border-line text-fg transition-colors hover:border-molten-400 hover:text-molten-300"
  >
    <span data-theme-icon="sun"><Icon name="sun" class="h-[1.05rem] w-[1.05rem]" /></span>
    <span data-theme-icon="moon"><Icon name="moon" class="h-[1.05rem] w-[1.05rem]" /></span>
  </button>
</div>
