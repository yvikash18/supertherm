---
import { company, nav, products } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const year = 2026;
---

<footer class="bg-grid relative mt-8 overflow-hidden border-t border-line bg-ink-2 pt-[4.5rem]">
  <div
    class="glow-blob"
    style="width:420px;height:420px;background:#f75d02;left:-8%;bottom:-30%;opacity:0.18"
  >
  </div>

  <div class="relative mx-auto grid w-full max-w-7xl gap-10 px-5 pb-12 sm:px-6 md:grid-cols-[2fr_1fr_1fr_1.3fr]">
    <div>
      <Logo />
      <p class="mt-[1.1rem] max-w-sm text-[0.92rem] leading-7 text-muted">{company.intro}</p>
      <div class="mt-5 flex gap-2.5">
        {
          [
            { h: company.social.linkedin, l: 'LinkedIn', d: 'M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.25 8h4.5v15.5H.25V8zm7.5 0h4.31v2.12h.06c.6-1.13 2.07-2.32 4.26-2.32 4.56 0 5.4 3 5.4 6.9v8.8h-4.5v-7.8c0-1.86-.03-4.25-2.6-4.25-2.6 0-3 2.03-3 4.12v7.93h-4.5V8z' },
            { h: company.social.facebook, l: 'Facebook', d: 'M24 12a12 12 0 10-13.88 11.86v-8.4H7.08V12h3.04V9.36c0-3 1.79-4.67 4.53-4.67 1.31 0 2.68.24 2.68.24v2.95h-1.51c-1.49 0-1.95.92-1.95 1.87V12h3.32l-.53 3.47h-2.79v8.39A12 12 0 0024 12z' },
            { h: company.social.twitter, l: 'X', d: 'M18.9 2H22l-7.5 8.58L23.5 22h-6.9l-5.4-7.06L4.98 22H2l8.05-9.2L1 2h7.06l4.88 6.45L18.9 2zm-2.42 18h1.9L7.6 4H5.56L16.48 20z' },
            { h: company.social.youtube, l: 'YouTube', d: 'M23.5 6.2a3 3 0 00-2.11-2.13C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.39.52A3 3 0 00.5 6.2 31.4 31.4 0 000 12a31.4 31.4 0 00.5 5.8 3 3 0 002.11 2.13c1.89.52 9.39.52 9.39.52s7.5 0 9.39-.52a3 3 0 002.11-2.13A31.4 31.4 0 0024 12a31.4 31.4 0 00-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z' },
          ].map((s) => (
            <a
              href={s.h}
              aria-label={s.l}
              target="_blank"
              rel="noopener noreferrer"
              class="grid h-10 w-10 place-items-center rounded-lg border border-line text-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-molten-400 hover:bg-molten-500 hover:text-white"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-[1.05rem] w-[1.05rem]" aria-hidden="true"><path d={s.d} /></svg>
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h4 class="mb-[1.1rem] text-[0.8rem] uppercase tracking-[0.18em] text-faint">Company</h4>
      <ul class="flex flex-col gap-2.5">
        {
          nav.map((n) => (
            <li>
              <a href={n.href} class="text-[0.92rem] text-muted transition-colors hover:text-molten-300">
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="mb-[1.1rem] text-[0.8rem] uppercase tracking-[0.18em] text-faint">Products</h4>
      <ul class="flex flex-col gap-2.5">
        {
          products.map((p) => (
            <li>
              <a href={`/products#${p.slug}`} class="text-[0.92rem] text-muted transition-colors hover:text-molten-300">
                {p.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="mb-[1.1rem] text-[0.8rem] uppercase tracking-[0.18em] text-faint">Get in touch</h4>
      <a href={`tel:${company.phoneRaw}`} class="mb-3.5 flex items-start gap-2.5 text-[0.92rem] text-muted transition-colors hover:text-molten-300">
        <Icon name="phone" class="mt-0.5 h-[1.1rem] w-[1.1rem] shrink-0 text-molten-300" />{company.phone}
      </a>
      <a href={`mailto:${company.email}`} class="mb-3.5 flex items-start gap-2.5 break-all text-[0.92rem] text-muted transition-colors hover:text-molten-300">
        <Icon name="mail" class="mt-0.5 h-[1.1rem] w-[1.1rem] shrink-0 text-molten-300" />{company.email}
      </a>
      <p class="flex items-start gap-2.5 text-[0.92rem] text-muted">
        <Icon name="pin" class="mt-0.5 h-[1.1rem] w-[1.1rem] shrink-0 text-molten-300" />
        <span>{company.address.line1}<br />{company.address.line2}</span>
      </p>
    </div>
  </div>

  <div class="relative mx-auto flex w-full max-w-7xl flex-col gap-2 border-t border-line px-5 py-6 text-[0.85rem] text-faint sm:px-6 md:flex-row md:items-center md:justify-between">
    <p>© {year} {company.name}. All rights reserved.</p>
    <p class="font-display text-molten-300">Excellence in Induction Technology</p>
  </div>
</footer>
