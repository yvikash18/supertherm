---
import { nav, products, socialLinks } from '../data/content';
import { company } from '../data/content';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
// Only links that have both a name and an address are shown
const social = socialLinks.filter((s) => s.label?.trim() && s.url?.trim());
---

<footer class="on-night ft">
  <div class="wrap cols">
    <div class="about">
      <Logo />
      <p>Induction heating machines for forging, hardening, melting and tube welding. Designed and built in Bahadurgarh, Haryana, with more than 30 years in induction.</p>
    </div>
    <div>
      <h2>Machines</h2>
      <ul>{products.map((p) => <li><a href={`/products#${p.slug}`}>{p.name}</a></li>)}</ul>
    </div>
    <div>
      <h2>Company</h2>
      <ul>{nav.filter((n) => n.href !== '/').map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h2>Works</h2>
      <address>
        {company.address.line1}<br />{company.address.line2}<br />
        <a href={`tel:${company.phoneRaw}`} class="num">{company.phone}</a><br />
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </address>
    </div>
  </div>
  <div class="wrap base">
    <p>© {year} {company.name}. {company.tagline}.</p>
    {social.length > 0 && <ul>{social.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}</ul>}
  </div>
</footer>

<style>
  .ft { border-top: 1px solid var(--line); padding-top: clamp(3rem, 6vw, 5rem); font-size: 0.9375rem; }
  .cols { display: grid; gap: 2.5rem; grid-template-columns: 1fr 1fr; }
  .about { grid-column: 1 / -1; }
  .about p { margin-top: 1.25rem; max-width: 26rem; color: var(--fg-2); }
  h2 { font-size: 0.9375rem; font-weight: 500; color: var(--fg-3); margin-bottom: 0.9rem; }
  ul { display: flex; flex-direction: column; gap: 0.5rem; }
  address { font-style: normal; line-height: 1.7; color: var(--fg-2); }
  a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: clamp(2.5rem, 5vw, 4rem); padding-block: 1.5rem; border-top: 1px solid var(--line); color: var(--fg-3); }
  .base ul { flex-direction: row; gap: 1.5rem; margin-right: 4.5rem; }
  @media (min-width: 900px) { .cols { grid-template-columns: 2fr 1fr 1fr 1.3fr; } .about { grid-column: auto; } }
</style>
