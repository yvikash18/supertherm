---
// Process animations: each machine family at work, drawn on a canvas and
// driven by a GSAP timeline (src/scripts/process-anim.ts). Pass one kind for a
// single scene, or several to get tabs.
import { processCopy, type Kind } from '../lib/process-copy';
interface Props { kinds: Kind[] }
const { kinds } = Astro.props;
const first = processCopy[kinds[0]];
---

<div class="proc on-night" data-proc data-kinds={kinds.join(',')}>
  {kinds.length > 1 && (
    <div class="tabs" role="tablist" aria-label="Process">
      {kinds.map((k, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-proc-tab={k}>{processCopy[k].tab}</button>
      ))}
    </div>
  )}
  <canvas aria-hidden="true"></canvas>
  <div class="bar">
    <dl>
      <div><dt data-proc-l0>{first.readouts[0]}</dt><dd class="num temp"><span data-proc-v0>30</span> <span data-proc-u0>{first.units[0]}</span></dd></div>
      <div><dt data-proc-l1>{first.readouts[1]}</dt><dd class="num"><span data-proc-v1>0</span><span data-proc-u1>{first.units[1]}</span></dd></div>
    </dl>
    <button type="button" class="btn btn-line btn-sm" data-proc-toggle aria-pressed="false">Pause</button>
  </div>
  <ol>
    {first.steps.map((s, i) => (
      <li data-proc-step={i}><span class="n num">{i + 1}</span><h3 class="h3">{s.title}</h3><p>{s.text}</p></li>
    ))}
  </ol>
</div>

<style>
  .proc { border-radius: 4px; overflow: hidden; }
  .tabs { display: flex; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--line); }
  .tabs button { padding: 1rem clamp(1rem, 2.5vw, 2rem); font-weight: 650; font-stretch: 90%; white-space: nowrap; color: var(--fg-3); border-bottom: 3px solid transparent; margin-bottom: -1px; transition: color 0.2s, border-color 0.2s; }
  .tabs button:hover { color: var(--fg); }
  .tabs button[aria-selected='true'] { color: var(--fg); border-bottom-color: var(--h900); }
  canvas { display: block; width: 100%; height: clamp(230px, 40vh, 400px); background: #070c12; }
  .bar { display: flex; flex-wrap: wrap; gap: 1rem 2rem; justify-content: space-between; align-items: center; padding: 1rem clamp(1.25rem, 3vw, 2.5rem); border-bottom: 1px solid var(--line); }
  dl { display: flex; flex-wrap: wrap; gap: 0.5rem 2.5rem; }
  dt { color: var(--fg-3); font-size: 0.875rem; }
  dd { font-weight: 650; font-size: 1.25rem; font-stretch: 88%; }
  .temp { color: var(--h1100); }
  ol { display: grid; }
  li { padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem); border-top: 3px solid transparent; opacity: 0.5; transition: opacity 0.4s, border-color 0.4s; }
  li.is-on { opacity: 1; border-top-color: var(--h900); }
  :global(html:not(.js)) .proc li { opacity: 1; }
  .n { display: block; color: var(--fg-3); font-weight: 700; margin-bottom: 0.4rem; }
  li p { color: var(--fg-2); margin-top: 0.4rem; max-width: 24rem; }
  @media (min-width: 800px) { ol { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 599px) {
    canvas { height: clamp(190px, 30vh, 260px); }
    .tabs button { flex: 1; padding-inline: 0.5rem; font-size: 0.9375rem; }
    li { padding-block: 1rem; }
  }
</style>

<script>
  import '../scripts/process-anim.ts';
</script>
